<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#1f2933">
<title>ТехноМайнинг — Сервисный инженер (прототип)</title>
<style>
:root{color-scheme:light dark;--bg:#f3f4f6;--card:#fff;--ink:#1c2128;--mut:#6b7280;--line:#e2e5ea;--acc:#e8700a;--acc2:#fff3e8;--tag:#9a4700;--ok:#15803d;--okb:#e7f6ec;--bad:#c62828;--badb:#fdecec;--sk:#8a8f98;--skb:#f0f1f3;
--inp:#fff;--inpbd:#cfd4db;--ghost:#e9ecf0;--soft:#f8f9fb;--soft2:#f3f4f6;--warnbg:#fff8e6;--warnbd:#f1d68a;--okrow:#f6fcf8;--badrow:#fff6f6;--offbd:#f3c9c9;--tripbg:#fffaf5;--inbg:#ffe2c6;--inbd:#f5b47a;--dupbg:#fff3b0;--dupbd:#e0b400;--dupin:#fff6cc;
--pinbg:#e8f1fb;--pinfg:#1f4f82;--freebg:#eef3fb;--vsoft:#faf5ff;--vbd:#e3d2f3;--violet:#6a1b9a;--info:#2f5d8a;--strong:#1f2933;--onstrong:#fff;--btn:#2b3640;--slotbd:#c9ced6;--imgph:#ddd;--mark:#ffe082;--shadow:var(--shadow)}
@media(prefers-color-scheme:dark){:root{--bg:#0f1318;--card:#181d24;--ink:#e6e8eb;--mut:#9aa3ae;--line:#2b323c;--acc:#f08a2a;--acc2:#3a2614;--tag:#f5b46b;--ok:#4ade80;--okb:#12301e;--bad:#f87171;--badb:#3a1717;--sk:#8a929c;--skb:#232930;
--inp:#11161c;--inpbd:#3a4350;--ghost:#262d36;--soft:#1e242c;--soft2:#20262e;--warnbg:#2f2610;--warnbd:#6b5418;--okrow:#13261a;--badrow:#2a1517;--offbd:#5a2a2a;--tripbg:#2a1f14;--inbg:#4a2f15;--inbd:#7a4a1f;--dupbg:#4a3d0a;--dupbd:#8a7010;--dupin:#3a3008;
--pinbg:#16283d;--pinfg:#9cc3ec;--freebg:#16283d;--vsoft:#221a2d;--vbd:#3d2a52;--violet:#c084fc;--info:#7fb2e5;--strong:#e6e8eb;--onstrong:#111;--btn:#36414d;--slotbd:#3d4652;--imgph:#2a3038;--mark:#7a5d00;--shadow:rgba(0,0,0,.6)}}
*{box-sizing:border-box}
body{margin:0;font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink);-webkit-tap-highlight-color:transparent}
header{position:sticky;top:0;z-index:20;background:#1f2933;color:#fff;display:flex;align-items:center;gap:10px;padding:10px 14px}
header .t{font-weight:700;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
header .t small{display:block;font-weight:400;opacity:.65;font-size:12px}
.back,.ubtn{background:none;border:0;color:#fff;font-size:24px;padding:0 6px;cursor:pointer}
.ubtn{font-size:13px;background:#344150;border-radius:20px;padding:6px 10px;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#net{font-size:12px;padding:5px 10px;border-radius:20px;white-space:nowrap}
#net.on{background:#1d6b3a}#net.off{background:#a24a00}#net.sync{background:#2f5d8a}
main{max-width:1100px;margin:0 auto;padding:14px 14px 110px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}
h2{margin:0 0 10px;font-size:20px}h3{margin:20px 0 10px;font-size:16px}h4{margin:16px 0 8px;font-size:14px;color:var(--mut)}
label{display:block;margin:10px 0;font-size:13px;color:var(--mut)}
input,select,textarea{width:100%;font:inherit;color:var(--ink);padding:11px 12px;border:1px solid var(--inpbd);border-radius:10px;background:var(--inp);margin-top:4px}
input[type=color]{padding:2px;height:42px;width:60px}
textarea{min-height:64px;resize:vertical}
input:focus,select:focus,textarea:focus{outline:2px solid var(--acc);border-color:transparent}
input.dup{background:var(--dupin);border-color:var(--dupbd)}
label.chk{display:flex;align-items:center;gap:8px;color:var(--ink);font-size:14px;margin:8px 0;cursor:pointer}
label.chk input{width:22px;height:22px;margin:0;accent-color:var(--acc)}
.btn{font:inherit;border:0;border-radius:10px;padding:11px 16px;background:var(--btn);color:#fff;cursor:pointer;font-weight:600}
.btn.pri{background:var(--acc)}.btn.ghost{background:var(--ghost);color:var(--ink)}.btn.red{background:var(--bad)}
.btn.sm{padding:7px 11px;font-size:13px}.btn.big{padding:15px 18px;font-size:16px;flex:1}
.btn:disabled{opacity:.4}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}
.muted{color:var(--mut)}.small{font-size:13px}.hint{font-size:13px;color:var(--mut);margin:4px 0 8px}
.tag{display:inline-block;background:var(--acc2);color:var(--tag);font-size:12px;font-weight:700;padding:3px 9px;border-radius:20px;margin-bottom:6px}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:14px}.kv span{color:var(--mut)}
.search{margin:14px 0}
.acard{display:flex;gap:12px;align-items:flex-start;width:100%;text-align:left;background:var(--card);border:1px solid var(--line);border-left:6px solid var(--mc,#999);border-radius:14px;padding:14px;margin-bottom:10px;cursor:pointer;font:inherit;color:inherit}
.acard .i{flex:1;min-width:0}.acard b{font-size:16px}.acard .m{color:var(--mut);font-size:13px;margin-top:3px}
.logo{flex:none;width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:17px;overflow:hidden;background:var(--mc,#999)}
.logo img{width:100%;height:100%;object-fit:contain;background:var(--card)}
.logo.sm{width:30px;height:30px;font-size:12px;border-radius:8px}
.dupm{background:var(--dupbg);padding:0 5px;border-radius:5px;outline:1px solid var(--dupbd)}
.kinds{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
.kind{font:inherit;text-align:left;background:var(--card);border:2px solid var(--line);border-radius:14px;padding:16px;cursor:pointer;color:inherit}
.kind:hover{border-color:var(--acc)}.kind b{display:block;font-size:16px;margin-bottom:4px}.kind small{color:var(--mut)}
.rrow{display:flex;gap:10px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:8px;flex-wrap:wrap}
.rrow .i{flex:1;min-width:200px}.rrow .m{font-size:13px;color:var(--mut)}
.st-d{color:var(--tag)}.st-ok{color:var(--ok)}
.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:6px;scrollbar-width:thin}
.chip{flex:none;font:inherit;font-size:13px;border:1px solid var(--line);background:var(--card);border-radius:20px;padding:7px 12px;cursor:pointer;color:var(--ink)}
.chip.done{background:var(--okb);border-color:var(--ok)}.chip.done::before{content:"✓ ";color:var(--ok)}
.chip.skipped{background:var(--skb);color:var(--sk);text-decoration:line-through}
.chip.cur{background:var(--strong);color:var(--onstrong);border-color:var(--strong);text-decoration:none}
.navbar{position:fixed;left:0;right:0;bottom:0;z-index:15;background:var(--card);border-top:1px solid var(--line);padding:10px 14px calc(10px + env(safe-area-inset-bottom));display:flex;gap:8px;justify-content:center}
.navbar .btn{flex:1;max-width:260px}
.slots,.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
.slot{border:2px dashed var(--slotbd);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:8px;align-items:stretch;justify-content:center;min-height:170px;text-align:center}
.slt{font-weight:700}
.ph{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--card)}
.ph.def{border:2px solid var(--bad)}
.ph img{width:100%;height:150px;object-fit:cover;display:block;cursor:zoom-in;background:var(--imgph)}
.phb{padding:8px}.phb textarea{min-height:48px;font-size:13px;padding:8px}
.phl{font-size:12px;font-weight:700;color:var(--mut)}.ph.def .phl{color:var(--bad)}
.phb .row{margin-top:4px;justify-content:space-between}.phb label.chk{font-size:13px;margin:0}
.addrow{display:flex;gap:8px;margin:8px 0 12px}.addrow .btn{flex:1}
.mode{display:flex;gap:6px;margin-bottom:6px}
.seg{flex:1;font:inherit;font-weight:600;border:2px solid var(--line);background:var(--card);border-radius:10px;padding:11px;cursor:pointer;color:var(--ink)}
.seg.on{border-color:var(--strong);background:var(--strong);color:var(--onstrong)}.seg.red.on{border-color:var(--bad);background:var(--bad);color:#fff}
.segs{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}.segs .seg{flex:none;padding:6px 12px;font-size:13px}
.mg{border:1px solid var(--line);border-radius:12px;margin-bottom:10px;overflow:hidden}
.mgh{display:flex;align-items:center;gap:10px;padding:12px;background:var(--soft);cursor:pointer}
.mgh b{flex:1}.mgh .c{font-size:12px;color:var(--mut)}
.mrow{padding:12px;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 210px;gap:8px 12px;align-items:center}
.mrow.s-ok{background:var(--okrow)}.mrow.s-bad{background:var(--badrow)}.mrow.s-skip{opacity:.55}
.mn{font-weight:600}.norm{font-weight:400;font-size:12px;color:var(--mut)}
.mi{display:flex;gap:6px;align-items:center}.mi input{margin:0;font-size:17px;font-weight:600}
.mx{grid-column:1/-1;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.mx label.chk{margin:0;font-size:13px}
.mext{grid-column:1/-1}
.badge{font-size:12px;font-weight:700;padding:4px 8px;border-radius:8px;white-space:nowrap;min-width:84px;text-align:center}
.b-ok{background:var(--okb);color:var(--ok)}.b-bad{background:var(--badb);color:var(--bad)}.b-none{background:var(--skb);color:var(--mut)}.b-skip{background:var(--skb);color:var(--sk)}.b-free{background:var(--freebg);color:var(--info)}
.calh{display:flex;align-items:center;justify-content:space-between;margin:8px 0}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;max-width:440px}
.cw{font-size:12px;color:var(--mut);text-align:center}.cw.we{color:var(--bad)}
.cd{position:relative;font:inherit;border:1px solid var(--line);background:var(--card);border-radius:8px;padding:10px 0;cursor:pointer;color:var(--ink)}
.cd.we{color:var(--bad)}
.cd.in{background:var(--inbg);border-color:var(--inbd)}
.cd.edge{background:var(--acc);color:#fff;border-color:var(--acc);font-weight:700}
.cd.pend{outline:3px solid var(--strong)}
.cd.wk::after{content:"";position:absolute;right:4px;top:4px;width:8px;height:8px;border-radius:50%;background:var(--violet);box-shadow:0 0 0 2px var(--card)}
.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--mut);margin:8px 0}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:4px}
.trip{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:10px;margin:6px 0;background:var(--tripbg)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.crow{display:grid;grid-template-columns:1fr 100px 100px 40px;gap:6px;align-items:center;margin-bottom:6px}
.crow input,.crow select{margin:0}
.irow{display:grid;grid-template-columns:2fr 70px 80px 80px 80px 36px;gap:6px;align-items:center;margin-bottom:6px}
.irow input{margin:0;padding:8px;font-size:14px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:12px 0}
.tile{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px}
.tile b{display:block;font-size:24px}.tile span{font-size:12px;color:var(--mut)}
.tile.bad b{color:var(--bad)}.tile.ok b{color:var(--ok)}
.th{margin:0;border-radius:10px;overflow:hidden;background:var(--card);border:1px solid var(--line);cursor:zoom-in}
.th.def{border:2px solid var(--bad)}
.th img{width:100%;height:140px;object-fit:cover;display:block}
.th figcaption{font-size:12px;padding:6px 8px;color:var(--mut)}
.th.def figcaption b{color:var(--bad)}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{font-size:12px;color:var(--mut);font-weight:600}
td.n{white-space:nowrap;font-variant-numeric:tabular-nums}
tr.s-bad td{background:var(--badrow)}tr.gr td{background:var(--soft2);font-weight:700}
.sumlist div{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--line);font-size:14px}
.warn{background:var(--warnbg);border:1px solid var(--warnbd);border-radius:10px;padding:10px;font-size:13px;margin:8px 0}
.banner{background:var(--badb);color:var(--bad);padding:10px 14px;font-size:13px;text-align:center}
#zoom{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px;color:#fff}
#zoom img{max-width:100%;max-height:78vh;object-fit:contain;border-radius:6px}
#zoom .cap{margin-top:10px;max-width:800px;text-align:center}
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#1f2933;color:#fff;padding:10px 16px;border-radius:10px;font-size:14px;z-index:60;opacity:0;transition:opacity .2s;pointer-events:none;max-width:90%}
#toast.show{opacity:1}
#umenu{position:fixed;top:56px;right:10px;z-index:40;background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 30px var(--shadow);padding:12px;min-width:240px}
#umenu .btn{width:100%;margin-top:6px}
.doc{white-space:pre-wrap;font-size:15px;line-height:1.6}
.drow{display:flex;gap:10px;align-items:center;padding:10px 0;border-top:1px solid var(--line);flex-wrap:wrap}
.drow .i{flex:1;min-width:180px}
.pdfwrap{position:relative;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.pdfwrap canvas{display:block;width:100%;margin-bottom:8px;border:1px solid var(--line);background:var(--card)}
.wm{color:var(--ink);position:absolute;inset:0;pointer-events:none;overflow:hidden;display:flex;flex-wrap:wrap;align-content:flex-start;gap:70px 40px;padding:30px;opacity:.13;font-weight:700;font-size:15px;color:#000;transform:rotate(-18deg);transform-origin:center}
.login{max-width:420px;margin:30px auto}
.lmark{width:64px;height:64px;border-radius:16px;background:var(--acc);color:#fff;font-weight:800;font-size:24px;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.tabs{display:flex;gap:6px;overflow-x:auto;margin-bottom:12px}
.tabs .seg{flex:none}
.urow{display:grid;grid-template-columns:1fr 160px 110px 120px 40px;gap:8px;align-items:center;padding:8px 0;border-top:1px solid var(--line)}
.urow select{margin:0}
.q4{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.q4 label{margin:4px 0}
.prop{border-top:1px solid var(--line);padding:10px 0}.prop:first-of-type{border-top:0}
.sres{display:block;width:100%;text-align:left;font:inherit;font-size:13px;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px;margin-bottom:6px;cursor:pointer;color:var(--ink)}
/* страницы PDF */
.pgph{position:relative;background:#fff;border:1px solid var(--line);margin-bottom:8px;overflow:hidden}.pgph canvas{display:block;width:100%;margin:0;border:0}
.pgph .pgno{position:absolute;left:50%;top:40%;transform:translateX(-50%);color:#9aa3ae;font-size:20px}
.pgph.flash{outline:4px solid var(--acc)}.pgph canvas~.pgno{display:none}
.wm1{position:absolute;inset:0;pointer-events:none;display:flex;flex-direction:column;justify-content:space-around;align-items:center;transform:rotate(-24deg);opacity:.12;font-weight:700;font-size:16px;color:#000}
.ntfloat{position:fixed;right:12px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:25;display:flex;gap:6px}.ntfloat .btn{box-shadow:0 2px 10px var(--shadow);border-radius:20px;padding:10px 14px;font-size:15px}
.pgnotes{position:absolute;right:6px;top:6px;display:flex;gap:4px;z-index:2}.pgnotes button{font:inherit;font-size:13px;border:0;border-radius:14px;padding:4px 9px;background:var(--acc);color:#fff;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.25)}
#sheet{position:fixed;left:0;right:0;bottom:0;z-index:30;max-height:62vh;display:flex;flex-direction:column;background:var(--card);border-top:1px solid var(--line);border-radius:16px 16px 0 0;box-shadow:0 -6px 24px var(--shadow);padding:10px 14px calc(10px + env(safe-area-inset-bottom));max-width:1100px;margin:0 auto}
.shh{display:flex;justify-content:space-between;align-items:center;gap:8px}.shb{overflow:auto;padding-top:6px}
.nrow{display:flex;gap:8px;align-items:flex-start;padding:8px 0;border-top:1px solid var(--line)}.nrow .i{flex:1;min-width:0}.nrow.hid{opacity:.6}
.ncform{border-top:1px solid var(--line);padding-top:8px;margin-top:6px}.ncform textarea{min-height:56px}
.mrow.mgrid{grid-template-columns:1fr auto}.gwrap{overflow-x:auto;margin:4px 0}.gtbl{border-collapse:collapse;font-size:13px;min-width:100%}.gtbl th,.gtbl td{border:1px solid var(--line);padding:3px 4px;text-align:center;white-space:nowrap}.gtbl th{background:var(--soft2);font-weight:600}
.gtbl input{width:72px;padding:6px 4px;margin:0;font-size:15px;text-align:center;border-radius:6px}.gtbl .gd{background:var(--soft)}input.g-bad,td.g-bad{background:var(--badb)!important;color:var(--bad);font-weight:700}input.g-ok,td.g-ok{background:var(--okrow)}
.annbtn{position:absolute;right:6px;top:6px;border:0;border-radius:50%;width:36px;height:36px;background:rgba(0,0,0,.55);color:#fff;font-size:16px;cursor:pointer}
.remtag{position:absolute;left:6px;top:6px;background:rgba(0,0,0,.6);color:#fff;font-size:11px;padding:2px 6px;border-radius:8px}
#ann{position:fixed;inset:0;z-index:60;background:#111;display:flex;flex-direction:column;padding:10px}.anntools{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.anntools .seg{flex:none;padding:8px 10px;color:#fff;background:#222;border-color:#444}.anntools .seg.on{background:#e8700a;border-color:#e8700a}
.anncol{display:flex;gap:6px}.anncol button{width:30px;height:30px;border-radius:50%;border:3px solid #333;cursor:pointer}.anncol button.on{border-color:#fff}
.anncv{flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-top:8px}.anncv canvas{max-width:100%;max-height:100%;touch-action:none;background:#000}
.anntxt{position:fixed;left:10px;right:10px;bottom:80px;display:flex;gap:6px;background:#222;padding:8px;border-radius:10px}.anntxt input{margin:0}
#micb{position:fixed;left:12px;bottom:calc(80px + env(safe-area-inset-bottom));z-index:45;width:52px;height:52px;border-radius:50%;border:0;background:var(--acc);color:#fff;font-size:24px;box-shadow:0 2px 10px var(--shadow);cursor:pointer}#micb.rec{background:var(--bad);animation:pulse 1s infinite}@keyframes pulse{50%{transform:scale(1.12)}}
body.big{font-size:17px}body.big .btn{padding:15px 20px;font-size:17px;min-height:52px}body.big .btn.sm{padding:11px 14px;font-size:15px;min-height:44px}body.big input,body.big select,body.big textarea{font-size:18px;padding:14px}body.big label.chk input{width:28px;height:28px}body.big .chip{padding:10px 14px;font-size:15px}body.big .gtbl input{width:84px;font-size:17px;padding:9px 4px}body.big .navbar .btn{min-height:56px}
